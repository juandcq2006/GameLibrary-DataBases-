# Copy to backend/.env and fill in real values. backend/.env is git-ignored and must never be committed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geekbond

# Port the Express API listens on (the Vite dev proxy targets it).
PORT=3000

# Free key from https://rawg.io/apidocs, used only by `npm run db:import-rawg` to download game data.
RAWG_API_KEY=

# Max connections the API opens. The CSE 335 server allows 2 per account, so use 1 there.
DB_CONNECTION_LIMIT=

# Signs the session cookie. Leave empty in development (a random per-process secret is used).
# In production set a long random value, or every restart logs everyone out.
AUTH_SECRET=

# true = /api/me/* and review writes require a valid session (401 otherwise).
# false = anonymous requests keep using the demo user, so the current frontend works
# until its login screen ships.
AUTH_REQUIRE_LOGIN=false
