{
  "name": "nexus-game-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "node backend/index.ts",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "typecheck:database": "tsc -p database/tsconfig.json",
    "verify": "npm run typecheck:backend && npm run typecheck:database && npm run lint && npm test && npm run build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "db:status": "node database/cli.ts status",
    "db:migrate": "node database/cli.ts migrate",
    "db:seed": "node database/cli.ts seed",
    "db:import-rawg": "node database/import-rawg.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
